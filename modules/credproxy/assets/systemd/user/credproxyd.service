[Unit]
Description=credproxy credential broker (per-user)
Documentation=https://github.com/takezoh/credproxy
After=default.target
ConditionPathExists=%h/.config/credproxyd/credentials/op-service-account.cred

[Service]
Type=simple
RuntimeDirectory=credproxyd
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=op-service-account:%h/.config/credproxyd/credentials/op-service-account.cred
ExecStart=%h/.local/lib/credproxy/bin/credproxyd --config %h/.config/credproxyd/config.toml
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t/credproxyd
PrivateTmp=true

[Install]
WantedBy=default.target
